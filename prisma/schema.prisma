generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enum tingkat aplikasi (Sistem)
enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

// Enum tingkat internal Gor/Bisnis
enum VendorRole {
  OWNER
  ADMIN
  STAFF
}

enum VendorStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum EventStatus {
  DRAFT
  ACTIVE
  CANCELLED
  COMPLETED
}

enum TicketStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Enum untuk jenis notifikasi
enum NotificationType {
  BOOKING_NEW      // Booking/Pesanan Baru
  PAYMENT_SUCCESS // Pembayaran Berhasil
  PAYMENT_FAILED  // Pembayaran Gagal
  ORDER_CANCELLED // Pesanan Dibatalkan
  RATING_NEW      // Ulasan/Rating Baru
  VENDOR_VERIFIED // Status Verifikasi Vendor
  TICKET_SOLD     // Tiket Event Terjual
  VENDOR_REGISTER // Pendaftaran Vendor Baru (untuk Admin)
  EVENT_NEW       // Event Baru Dibuat (untuk Admin)
  USER_SUSPENDED  // Pengguna Disuspend (untuk Admin)
  VENDOR_INVITE   // Undangan Bergabung Vendor
}

// Enum untuk target notifikasi
enum NotificationTarget {
  VENDOR   // Untuk Vendor (Owner/Admin/Staff)
  ADMIN   // Untuk Admin
  USER    // Untuk User biasa
}

model Notification {
  id        String             @id @default(cuid())
  userId    String             // User yang menerima notifikasi
  type      NotificationType
  target    NotificationTarget // Target: VENDOR, ADMIN, atau USER
  title     String
  message   String
  data      Json?              // Data tambahan (misal: orderId, eventId, dll)
  isRead    Boolean            @default(false)
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([target, createdAt])
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  phone           String
  password        String
  role            Role     @default(CUSTOMER)
  
  address         String   @default("")
  district        String   @default("")
  
  isSuspended     Boolean  @default(false)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  notifications   Notification[]
  vendorMemberships VendorMember[]
  cartItems         CartItem[]
  orders            Order[]
  eventJoins        EventParticipant[]
  eventTickets      EventTicket[]
  events            Event[]
  ratings           VenueRating[]
  vendorRatings     VendorRating[]
}

enum WithdrawalStatus {
  PENDING
  PROCESSING // Opsional: Saat admin sedang ngecek/transfer
  SUCCESS
  REJECTED
}

model Withdrawal {
  id              String           @id @default(cuid())
  vendorId        String
  amount          Int
  status          WithdrawalStatus @default(PENDING)
  bankName        String
  accountNumber   String
  accountName     String
  adminNote       String?          // Alasan jika ditolak/pesan admin
  proofUrl        String?          // URL gambar bukti transfer dari admin (opsional)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

// Menggantikan VendorProfile menjadi entitas Organisasi
model Vendor {
  id                String       @id @default(cuid())
  name              String       // Nama bisnis (cth: "Gor Sukamaju")
  description       String       @default("")
  status            VendorStatus @default(PENDING)

  // Data rekening bank untuk payout
  bankName          String       @default("")
  bankAccountNumber String       @default("")
  bankAccountName   String       @default("")
  withdrawals     Withdrawal[]
  
  // Saldo vendor
  balance           Int          @default(0)
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  members           VendorMember[]
  venues            Venue[]
  ratings           VendorRating[]
}

model VendorMember {
  id        String     @id @default(cuid())
  userId    String
  vendorId  String
  role      VendorRole @default(STAFF)
  joinedAt  DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId]) // 1 user hanya bisa punya 1 role di 1 vendor yang sama
}

model Venue {
  id           String  @id @default(cuid())
  name         String
  description  String
  city         String  @default("")
  district     String  @default("")
  address      String  @default("")
  latitude     Float?
  longitude    Float?
  vendorId     String
  thumbnailUrl String  @default("")
  openHour     Int     @default(8)   // Jam buka (0-23)
  closeHour    Int     @default(22)  // Jam tutup (0-23)
  isOpen       Boolean @default(true) // Status Buka/Tutup renovasi

  // Relasi diubah menunjuk ke model Vendor (bukan VendorProfile)
  vendor  Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  fields  Field[]
  images  VenueImage[]
  ratings VenueRating[]
}

model VenueRating {
  id        String   @id @default(cuid())
  venueId   String
  userId    String
  rating    Int      // 1-5
  comment   String   @default("")
  createdAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorRating {
  id        String   @id @default(cuid())
  vendorId  String
  userId    String
  orderId   String   @unique  // Satu rating per order
  rating    Int      // 1-5
  comment   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([userId])
}

model VenueImage {
  id      String  @id @default(cuid())
  venueId String
  url     String
  title   String?  
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model Field {
  id           String  @id @default(cuid())
  name         String
  type         String
  floorType    String  @default("")
  length       Float   @default(0)
  width        Float   @default(0)
  price        Int
  description  String  @default("")
  venueId      String
  thumbnailUrl String  @default("") 
  title        String? @default("") 

  venue      Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  images     FieldImage[]
  contacts   FieldContact[]
}

model FieldImage {
  id      String @id @default(cuid())
  fieldId String
  title   String
  url     String

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

model FieldContact {
  id      String @id @default(cuid())
  fieldId String
  name    String
  email   String @default("")
  phone   String @default("")

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

model CartItem {
  id           String   @id @default(cuid())
  userId       String
  fieldId      String?
  eventId      String?
  ticketTierId String?
  ticketPrice  Int?     @default(0)
  date         DateTime
  startHour    Int
  endHour      Int
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  field      Field?           @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  event      Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTier EventTicketTier? @relation(fields: [ticketTierId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  totalAmount   Int
  status        OrderStatus @default(PENDING)
  customerName  String      @default("")
  customerPhone String      @default("")
  customerEmail String      @default("")
  notes         String      @default("")
  cancelReason  String?
  createdAt     DateTime    @default(now())
  expiresAt     DateTime    // Waktu kedaluwarsa payment (24 jam dari creation)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  payment      Payment?
  eventTickets EventTicket[]
  vendorRating VendorRating?

  @@index([status, expiresAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  fieldId   String
  date      DateTime
  startHour Int
  endHour   Int
  price     Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  amount    Int
  method    String
  status    PaymentStatus @default(PENDING)
  qrCode    String        @default("")
  expiredAt DateTime
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  snapToken String?
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Event {
  id              String      @id @default(cuid())
  title           String
  description     String
  location        String
  city            String      @default("")
  district        String      @default("")
  category        String      @default("")
  topic           String      @default("")        
  imageUrl        String      @default("")
  date            DateTime
  endDate         DateTime                        
  startHour       Int
  endHour         Int
  capacity        Int
  creatorId       String
  createdAt       DateTime    @default(now())
  status          EventStatus @default(DRAFT)
  additionalInfo  String      @default("")
  termsConditions String      @default("")
  contactName     String      @default("")
  contactEmail    String      @default("")
  contactPhone    String      @default("")
  latitude        Float?
  longitude       Float?
  ticketPrice     Int         @default(0)
  allowMultiplePurchases Boolean @default(false)
  
  creator         User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  ticketTiers     EventTicketTier[]  @relation("EventToTickets")
  participants    EventParticipant[]
  cartItems       CartItem[]
  eventTickets    EventTicket[]
}

model EventTicketTier {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  stock       Int
  description String   @default("")
  price       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     Event      @relation("EventToTickets", fields: [eventId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([eventId])
}

model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventTicket {
  id          String       @id @default(cuid())
  eventId     String
  userId      String
  quantity    Int          @default(1)
  totalPrice  Int
  status      TicketStatus @default(PENDING)
  orderId     String?      
  createdAt   DateTime     @default(now())
  confirmedAt DateTime?

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
}