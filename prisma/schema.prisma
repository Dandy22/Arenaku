generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum EventStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String
  password    String
  role        Role     @default(CUSTOMER)
  isSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())

  vendorProfile VendorProfile?
  cartItems     CartItem[]
  orders        Order[]
  eventJoins    EventParticipant[]
  eventTickets  EventTicket[]
  events        Event[]
  ratings       VenueRating[]
}

model VendorProfile {
  id     String       @id @default(cuid())
  userId String       @unique
  status VendorStatus @default(PENDING)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  venues Venue[]
}

model Venue {
  id          String  @id @default(cuid())
  name        String
  description String
  city        String  @default("")  // Kota Bekasi
  district    String  @default("")  // 12 Kecamatan: Medan Satria, Bekasi Utara, Bekasi Timur, Rawalumbu, Mustikajaya, Bantargebang, Bekasi Barat, Bekasi Selatan, Jatiasih, Pondokmelati, Jatisampurna, Pondokgede
  address     String  @default("")
  latitude    Float?
  longitude   Float?
  vendorId    String

  vendor  VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  fields  Field[]
  images  VenueImage[]
  ratings VenueRating[]
}

model VenueRating {
  id        String   @id @default(cuid())
  venueId   String
  userId    String
  rating    Int      // 1-5
  comment   String   @default("")
  createdAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId]) // satu user hanya bisa rating satu venue sekali
}

model VenueImage {
  id      String @id @default(cuid())
  venueId String
  url     String

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model Field {
  id          String @id @default(cuid())
  name        String
  type        String
  floorType   String @default("")
  length      Float  @default(0)
  width       Float  @default(0)
  price       Int
  description String @default("")
  venueId     String

  venue      Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  images     FieldImage[]
  contacts   FieldContact[]
}

model FieldImage {
  id      String @id @default(cuid())
  fieldId String
  url     String

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

model FieldContact {
  id      String @id @default(cuid())
  fieldId String
  name    String
  email   String @default("")
  phone   String @default("")

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  fieldId   String?  // Nullable - bisa field atau event
  eventId   String?  // Nullable - bisa field atau event
  date      DateTime
  startHour Int
  endHour   Int
  quantity  Int      @default(1) // Untuk event ticket
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  field Field? @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Validasi: harus ada field ATAU event, tidak keduanya
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  totalAmount   Int
  status        OrderStatus @default(PENDING)
  customerName  String      @default("")
  customerPhone String      @default("")
  customerEmail String      @default("")
  notes         String      @default("")
  createdAt     DateTime    @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   OrderItem[]
  payment Payment?
  eventTickets EventTicket[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  fieldId   String
  date      DateTime
  startHour Int
  endHour   Int
  price     Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  amount    Int
  method    String
  status    PaymentStatus @default(PENDING)
  qrCode    String        @default("")
  expiredAt DateTime
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Event {
  id               String     @id @default(cuid())
  title            String
  description      String
  location         String
  city             String     @default("")  // Kota Bekasi
  district         String     @default("")  // 12 Kecamatan
  category         String     @default("")
  imageUrl         String     @default("")
  date             DateTime
  startHour        Int
  endHour          Int
  ticketPrice      Int
  capacity         Int
  creatorId        String
  createdAt        DateTime   @default(now())
  status           EventStatus @default(ACTIVE)

  additionalInfo   String   @default("")  // Informasi Tambahan
  termsConditions  String   @default("")  // Syarat dan Ketentuan
  contactName      String   @default("")  // Narahubung
  contactEmail     String   @default("")
  contactPhone     String   @default("")
  latitude         Float?                 // koordinat peta
  longitude        Float?

  creator      User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  participants EventParticipant[]
  cartItems    CartItem[]
  eventTickets EventTicket[]
}

model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// Model untuk ticket event yang dibeli melalui cart + payment
model EventTicket {
  id            String            @id @default(cuid())
  eventId       String
  userId        String
  quantity      Int               @default(1)
  totalPrice    Int
  status        TicketStatus      @default(PENDING)
  orderId       String?           // Link ke Order jika dibeli via cart
  createdAt     DateTime          @default(now())
  confirmedAt   DateTime?

  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
}

enum TicketStatus {
  PENDING
  CONFIRMED    // Sudah dibayar
  CANCELLED
}